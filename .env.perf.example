# Copy to ../private/shop/.env.perf; 03-local.bat loads it outside Git.
# Set RVL_PRIVATE_DIR to use another private shop directory.
# Restart 03-local.bat after edits. Settings are applied without rebuilding.
# Leave URL empty until the upstream is ready. Empty URL uses local metrics.
# One upstream per instance; HTTPS base URL, without /api or /v1.
PERF_UPSTREAM_URL=
# Optional server-side credential with permission to read performance metrics.
# These stats are visible to everyone allowed to view your Pricing page.
PERF_UPSTREAM_API_KEY=
# Optional local-to-upstream model names as a single-line JSON object.
# Empty uses identical names. A map restricts display to the listed models.
# Example: {"my-model":"upstream-model"}
PERF_UPSTREAM_MODEL_MAP=
